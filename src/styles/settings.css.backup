/* ===== JyOS 设置应用：韩系低饱和度白色 IG 风格 ===== */

.settings-app {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  background: #fafafa;
  color: #262626;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", sans-serif;
  padding-top: env(safe-area-inset-top);
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
}

/* 顶栏 - IG 风格 */
.app-header {
  flex: none;
  display: flex;
  align-items: center;
  padding: 12px 16px;
  background: #ffffff;
  border-bottom: 1px solid #dbdbdb;
}

.back-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: none;
  background: transparent;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: background 0.15s ease;
}
.back-btn:hover {
  background: #f2f2f2;
}
.back-btn:active {
  background: #e8e8e8;
}
.back-btn svg {
  width: 22px;
  height: 22px;
  fill: none;
  stroke: #262626;
  stroke-width: 2.5;
